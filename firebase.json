{
  "hosting": {
    "site": "periodic-table-adj",
    "public": ".",
    "redirects": [
      {
        "source": "/apk",
        "destination": "https://github.com/adj620/periodic-table/releases/download/v1.3.1/periodic-table.apk",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "https://github.com/adj620/periodic-table/releases/download/v1.3.1/periodic-table.apk",
        "type": 302
      },
      {
        "source": "/download",
        "destination": "/download.html",
        "type": 302
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "www/**",
      "*.apk",
      "package*.json",
      "capacitor.config.json",
      "deploy.ps1",
      "deploy.bat",
      "server.js"
    ]
  }
}
