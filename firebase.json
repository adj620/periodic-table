{
  "hosting": {
    "site": "periodic-table-adj",
    "public": ".",
    "redirects": [
      {
        "source": "/apk",
        "destination": "/periodic-table.zip",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "/download.html",
        "type": 302
      },
      {
        "source": "/download",
        "destination": "/download.html",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, HEAD, OPTIONS"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "/gemini_service.js",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "/periodic-table.zip",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Expose-Headers",
            "value": "Content-Length, Content-Disposition"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"periodic-table.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "/apk",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"periodic-table.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "www/**",
      "*.apk",
      "package*.json",
      "capacitor.config.json",
      "deploy.ps1",
      "deploy.bat",
      "server.js"
    ]
  }
}
