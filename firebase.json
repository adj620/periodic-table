{
  "hosting": {
    "site": "periodic-table-adj",
    "public": ".",
    "redirects": [
      {
        "source": "/apk",
        "destination": "/periodic-table.zip",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "/download.html",
        "type": 302
      },
      {
        "source": "/download",
        "destination": "/download.html",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/periodic-table.zip",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"periodic-table.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      },
      {
        "source": "/apk",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"periodic-table.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "www/**",
      "*.apk",
      "package*.json",
      "capacitor.config.json",
      "deploy.ps1",
      "deploy.bat",
      "server.js"
    ]
  }
}
